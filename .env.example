# TradeAnalyze v2.0 — Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# .env is already in .gitignore.

# ── LINE Messaging API ────────────────────────────────────────────────────────
# Required for LINE alerts (original + institutional v2)
# Get from: https://developers.line.biz/console/
LINE_TOKEN=your_line_channel_access_token_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Required for all Google Sheets reporting
# The spreadsheet ID is in the URL:
#   https://docs.google.com/spreadsheets/d/SHEET_ID/edit
SHEET_ID=your_google_sheet_id_here

# Path to your Google Service Account credentials JSON file
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_CREDS_FILE=credentials/google_service_account.json

# ── Exchange API Keys ─────────────────────────────────────────────────────────
# OKX — used for Long/Short ratio (public endpoint, no auth required)
# Only needed if using authenticated OKX endpoints in future
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Binance — used for funding rate and OI data
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ── FRED API (optional — Phase 12 M2 Liquidity) ───────────────────────────────
# Free key from: https://fred.stlouisfed.org/docs/api/api_key.html
# If not set, M2 liquidity signal is skipped (other signals still run)
FRED_API_KEY=

# ── Application Config ────────────────────────────────────────────────────────
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Target symbol for single-symbol mode
DEFAULT_SYMBOL=BTC

# Timezone for scheduled runs (LINE alerts use Bangkok time)
TZ=Asia/Bangkok

# ── Conviction Thresholds (tunable without code changes) ──────────────────────
# Minimum conviction score to send LINE alert (0–100)
MIN_CONVICTION_ALERT=60

# Minimum conviction score to execute trade
MIN_CONVICTION_TRADE=50

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable, "false" to disable

# Use XGBoost/LightGBM forecast (false = statistical fallback always)
ENABLE_ML_FORECAST=true

# Run cross-asset engine (fetches SPY/QQQ/GLD/DXY/TLT via yfinance)
ENABLE_CROSS_ASSET=true

# Run market breadth engine (fetches sector ETFs via yfinance)
ENABLE_BREADTH=true

# Run liquidity regime engine (fetches VIX/DXY/TLT via yfinance)
ENABLE_LIQUIDITY=true

# Run portfolio optimizer (HRP/Risk Parity)
ENABLE_PORTFOLIO_OPT=true

# Send institutional LINE alerts (requires LINE_TOKEN)
ENABLE_LINE_ALERTS=true

# Write to Google Sheets (requires SHEET_ID + GOOGLE_CREDS_FILE)
ENABLE_SHEETS=true
